#!name=po0 防火墙面板
#!desc=提供 po0 防火墙手动刷新 Panel。启用本模块后显示面板，关闭本模块后面板消失。
#!category=po0
#!author=reallinzc
#!arguments=tokens:""
#!arguments-desc=tokens: po0 防火墙 API token（pgnfw_ 开头），多台机器用英文逗号 , 分割；可选在 token 后加 @槽位（如 pgnfw_xxx@0）钉固定坑位、永不被淘汰

[Rule]
# 加白 API 必须直连
IP-CIDR,124.221.69.228/32,DIRECT,no-resolve

[Script]
po0-fw-panel = type=generic,script-path=https://raw.githubusercontent.com/reallinzc/po0fw/main/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"

[Panel]
po0-fw = script-name=po0-fw-panel,title=po0 防火墙加白,content=点击刷新,update-interval=300
